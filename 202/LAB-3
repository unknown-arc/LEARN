/* -----------------------------------------------------
   Q1. Find names of all Juniors (JR) who are enrolled
       in a class taught by I. Teach.
   ----------------------------------------------------- */

SELECT DISTINCT S.SName
FROM Student S
JOIN Enrolled E
    ON S.SID = E.SID
JOIN Class C
    ON E.CName = C.CName
JOIN Faculty F
    ON C.FID = F.FID
WHERE S.Level = 'JR'
AND F.FName = 'I. Teach';


/* -----------------------------------------------------
   Q2. Find age of the oldest student who is either
       a History major OR enrolled in a course taught
       by I. Teach.
   ----------------------------------------------------- */

SELECT MAX(S.Age) AS Oldest_Age
FROM Student S
WHERE S.Major = 'History'
OR S.SID IN
(
    SELECT E.SID
    FROM Enrolled E
    JOIN Class C
        ON E.CName = C.CName
    JOIN Faculty F
        ON C.FID = F.FID
    WHERE F.FName = 'I. Teach'
);


/* -----------------------------------------------------
   Q3. Find names of all classes that either meet in
       room R128 OR have five or more students enrolled.
   ----------------------------------------------------- */

SELECT C.CName
FROM Class C
LEFT JOIN Enrolled E
    ON C.CName = E.CName
GROUP BY C.CName, C.Room
HAVING C.Room = 'R128'
OR COUNT(E.SID) >= 5;


/* -----------------------------------------------------
   Q4. Find names of students who are enrolled in two
       classes that meet at the same time.
   ----------------------------------------------------- */

SELECT DISTINCT S.SName
FROM Student S
JOIN Enrolled E1
    ON S.SID = E1.SID
JOIN Class C1
    ON E1.CName = C1.CName
JOIN Enrolled E2
    ON S.SID = E2.SID
JOIN Class C2
    ON E2.CName = C2.CName
WHERE C1.CName <> C2.CName
AND C1.MeetsAt = C2.MeetsAt;


/* -----------------------------------------------------
   Q5. Find names of faculty members for whom the
       combined enrollment of courses they teach
       is less than five.
   ----------------------------------------------------- */

SELECT F.FName
FROM Faculty F
LEFT JOIN Class C
    ON F.FID = C.FID
LEFT JOIN Enrolled E
    ON C.CName = E.CName
GROUP BY F.FID, F.FName
HAVING COUNT(E.SID) < 5;


/* -----------------------------------------------------
   Q6. Print Level and average age for each Level.
   ----------------------------------------------------- */

SELECT Level,
       AVG(Age) AS Average_Age
FROM Student
GROUP BY Level;


/* -----------------------------------------------------
   Q7. Print Level and average age for all Levels
       except JR.
   ----------------------------------------------------- */

SELECT Level,
       AVG(Age) AS Average_Age
FROM Student
WHERE Level <> 'JR'
GROUP BY Level;


/* -----------------------------------------------------
   Q8. Find names of students who are enrolled in the
       maximum number of classes.
   ----------------------------------------------------- */

SELECT S.SName
FROM Student S
LEFT JOIN Enrolled E
    ON S.SID = E.SID
GROUP BY S.SID, S.SName
HAVING COUNT(E.CName) =
(
    SELECT MAX(Class_Count)
    FROM
    (
        SELECT S2.SID,
               COUNT(E2.CName) AS Class_Count
        FROM Student S2
        LEFT JOIN Enrolled E2
            ON S2.SID = E2.SID
        GROUP BY S2.SID
    ) AS X
);


/* -----------------------------------------------------
   Q9. Find names of students who are not enrolled
       in any class.
   ----------------------------------------------------- */

SELECT S.SName
FROM Student S
LEFT JOIN Enrolled E
    ON S.SID = E.SID
WHERE E.SID IS NULL;
